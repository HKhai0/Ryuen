# ==========================================
# HỆ THỐNG NÃO BỘ - QUẢN LÝ MODULES
# ==========================================
MODULES_DIR = "modules"
COMMAND_REGISTRY = {} # Nơi chứa từ điển các lệnh

def load_all_modules():
    """Hàm tự động quét và nạp các file .py trong thư mục modules"""
    if not os.path.exists(MODULES_DIR):
        os.makedirs(MODULES_DIR)
        print(f"{Fore.YELLOW}Đã tạo thư mục '{MODULES_DIR}'. Hãy bỏ file code plugin vào đây.")
        return

    print(f"{Fore.CYAN}Đang nạp các Modules...")
    for filename in os.listdir(MODULES_DIR):
        if filename.endswith(".py") and not filename.startswith("__"):
            module_name = filename[:-3]
            file_path = os.path.join(MODULES_DIR, filename)
            
            try:
                # Kỹ thuật load module động của Python
                spec = importlib.util.spec_from_file_location(module_name, file_path)
                module = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(module)
                
                # Tìm hàm ryuen_get
                if hasattr(module, "ryuen_get"):
                    commands = module.ryuen_get()
                    for cmd, func in commands.items():
                        COMMAND_REGISTRY[cmd.lower()] = func
                    print(f"{Fore.GREEN}  + Đã nạp thành công module: [{module_name}] (Lệnh: {', '.join(commands.keys())})")
            except Exception as e:
                print(f"{Fore.RED}  - Lỗi khi nạp module '{module_name}': {e}")

load_all_modules() # Kích hoạt nạp module khi bật Backend

def check_rsmode_permission(author_id, thread_id):
    """Trạm kiểm duyệt: Quyết định xem có phản hồi hay không"""
    config_file = "rsmode_config.json"
    if not os.path.exists(config_file):
        return True # Mặc định thả cửa nếu chưa cài module rsmode
    
    try:
        with open(config_file, 'r', encoding='utf-8') as f:
            cfg = json.load(f)
    except:
        return True

    mode = cfg.get("mode", "all")
    admins = cfg.get("admins", [])
    allowlist = cfg.get("allowlist", [])

    # QUY TẮC SỐ 1: Admin là Vua. Chấp mọi thể loại mode.
    if str(author_id) in admins:
        return True

    # Phân loại mode
    if mode == "all":
        return True
    elif mode == "admin":
        return False # Đã chặn từ quy tắc 1, những thằng lọt xuống đây là thường dân -> Block
    elif mode == "allow":
        # Cho phép nếu ID Cá nhân hoặc ID Nhóm có trong danh sách VIP
        if str(author_id) in allowlist or str(thread_id) in allowlist:
            return True
        return False

    return True

def handle_bot_logic(payload):
    """Hàm não bộ chính, sẽ dò xem tin nhắn có khớp lệnh trong Registry không"""
    if payload.get("event_type") != "onMessage":
        return {"method": None}
        
    data = payload.get("data", {})
    msg_text = data.get("msg_text", "").strip()
    author_id = str(data.get("author_id", ""))
    thread_id = str(data.get("thread_id", ""))
    
    if not msg_text:
        return {"method": None}
        
    parts = msg_text.split()
    first_word = parts[0].lower()
    
    # KHI PHÁT HIỆN TỪ ĐẦU TIÊN LÀ MỘT LỆNH ĐÃ ĐƯỢC NẠP
    if first_word in COMMAND_REGISTRY:
        
        # 🚧 TRẠM KIỂM DUYỆT 🚧
        if not check_rsmode_permission(author_id, thread_id):
            # Nếu không có quyền: Trả về một icon cấm để người dùng biết họ bị block
            return {"method": "react", "content": "⛔"} 
            
        try:
            # Gọi hàm execute() của module đó
            response = COMMAND_REGISTRY[first_word](data, parts)
            return response
        except Exception as e:
            print(f"{Fore.RED}❌ Lỗi khi thực thi lệnh '{first_word}': {e}")
            return {"method": "reply", "content": "❌ Lỗi hệ thống khi chạy module này!"}

    # Nếu gõ linh tinh không đúng lệnh nào
    return {"method": None}

init(autoreset=True)
app = FastAPI()

# ==========================================
# DATABASE SQLITE3 (NÂNG CẤP CHỐNG KẸT XE)
# ==========================================
def init_db():
    # Thêm timeout=10 để bắt nó ráng đợi 10s nếu DB đang bận, thay vì báo lỗi ngay
    conn = sqlite3.connect("chat_history.db", timeout=10)
    c = conn.cursor()
    # Bật chế độ WAL (Viết nhật ký trước) -> Tăng tốc độ ghi x10 lần
    c.execute('PRAGMA journal_mode=WAL;')
    # Bật chế độ đồng bộ NORMAL -> Cân bằng giữa tốc độ và an toàn
    c.execute('PRAGMA synchronous=NORMAL;')
    
    c.execute('''CREATE TABLE IF NOT EXISTS messages
                 (mid TEXT PRIMARY KEY, thread_id TEXT, timestamp TEXT, data_json TEXT)''')
    c.execute('CREATE INDEX IF NOT EXISTS idx_thread ON messages (thread_id)')
    conn.commit()
    conn.close()

init_db()

# ==========================================
# QUẢN LÝ WEBSOCKET
# ==========================================
class ConnectionManager:
    def __init__(self):
        self.active_connections: list[WebSocket] = []

    async def connect(self, websocket: WebSocket):
        await websocket.accept()
        self.active_connections.append(websocket)

    def disconnect(self, websocket: WebSocket):
        self.active_connections.remove(websocket)

    async def broadcast(self, data: dict):
        for connection in self.active_connections:
            try: await connection.send_json(data)
            except: pass

manager = ConnectionManager()

# ==========================================
# API ENDPOINTS
# ==========================================
@app.post("/webhook")
async def webhook(request: Request):
    payload = await request.json()
    
    if payload.get("event_type") == "onMessage":
        msg_data = payload.get("data", {})
        mid = msg_data.get("mid")
        thread_id = msg_data.get("thread_id")
        timestamp = msg_data.get("timestamp")
        
        try:
            # Thêm timeout để chống lỗi database is locked
            conn = sqlite3.connect("chat_history.db", timeout=10)
            c = conn.cursor()
            
            # 1. Ghi tin nhắn mới
            c.execute("INSERT OR IGNORE INTO messages VALUES (?, ?, ?, ?)", 
                      (mid, thread_id, timestamp, json.dumps(payload)))
            
            # 2. BỘ DỌN RÁC: Chỉ giữ lại 20000 tin nhắn mới nhất (Giúp DB luôn siêu nhẹ)
            c.execute("""
                DELETE FROM messages 
                WHERE rowid NOT IN (
                    SELECT rowid FROM messages ORDER BY rowid DESC LIMIT 20000
                )
            """)
            
            conn.commit()
            conn.close()
        except Exception as e:
            print(f"{Fore.RED}❌ Lỗi Ghi DB: {e}")

    await manager.broadcast(payload)
    return handle_bot_logic(payload)

@app.post("/api/react")
async def web_react(request: Request):
    data = await request.json()
    icon_text = data.get("icon")
    mid = data.get("mid")
    thread_id = data.get("thread_id")
    
    msg_object_str = None
    thread_type = None
    try:
        conn = sqlite3.connect("chat_history.db")
        c = conn.cursor()
        c.execute("SELECT data_json FROM messages WHERE mid=?", (mid,))
        row = c.fetchone()
        conn.close()
        
        if row:
            saved_payload = json.loads(row[0])
            msg_object_str = saved_payload["data"]["object"]
            thread_type = saved_payload["data"]["thread_type"]
            if not thread_id:
                thread_id = saved_payload["data"]["thread_id"]
    except Exception as e:
        print(f"{Fore.RED}❌ Lỗi tìm Object trong DB: {e}")

    try:
        bot_payload = {
            "mid": mid, 
            "icon": icon_text,
            "object": msg_object_str,
            "thread_type": thread_type,
            "thread_id": thread_id 
        }
        res = requests.post("http://127.0.0.1:3667/bot_react", json=bot_payload, timeout=3)
        return res.json() 
    except Exception as e:
        return {"status": "error", "message": "Bot đang tắt hoặc mất kết nối API"}

@app.post("/api/reply")
async def web_reply(request: Request):
    data = await request.json()
    mid = data.get("mid")
    text = data.get("text")
    thread_id = data.get("thread_id")
    
    msg_object_str, thread_type = None, None
    try:
        conn = sqlite3.connect("chat_history.db")
        c = conn.cursor()
        c.execute("SELECT data_json FROM messages WHERE mid=?", (mid,))
        row = c.fetchone()
        conn.close()
        if row:
            saved_payload = json.loads(row[0])
            msg_object_str = saved_payload["data"]["object"]
            thread_type = saved_payload["data"]["thread_type"]
            if not thread_id: thread_id = saved_payload["data"]["thread_id"]
    except Exception: pass

    try:
        bot_payload = { "mid": mid, "text": text, "object": msg_object_str, "thread_type": thread_type, "thread_id": thread_id }
        res = requests.post("http://127.0.0.1:3667/bot_reply", json=bot_payload, timeout=3)
        return res.json() 
    except Exception: return {"status": "error"}

@app.post("/api/send")
async def web_send(request: Request):
    data = await request.json()
    try:
        res = requests.post("http://127.0.0.1:3667/bot_send", json=data, timeout=3)
        return res.json() 
    except Exception: return {"status": "error"}

# --- 1. LẤY LỊCH SỬ CHUNG (LOAD LÚC MỚI MỞ WEB) ---
@app.get("/api/history")
async def get_history():
    try:
        conn = sqlite3.connect("chat_history.db")
        c = conn.cursor()
        # Lấy 150 tin nhắn toàn hệ thống để dựng Sidebar
        c.execute("SELECT data_json FROM messages ORDER BY rowid DESC LIMIT 150")
        rows = c.fetchall()
        conn.close()
        history = [json.loads(row[0]) for row in reversed(rows)]
        return {"status": "success", "data": history}
    except Exception as e:
        return {"status": "error", "data": []}

# --- 2. LẤY LỊCH SỬ RIÊNG TỪNG NHÓM (KHI CUỘN CHUỘT LÊN TRÊN) ---
@app.get("/api/thread_history")
async def get_thread_history(thread_id: str, offset: int = 0):
    try:
        conn = sqlite3.connect("chat_history.db")
        c = conn.cursor()
        c.execute("SELECT data_json FROM messages WHERE thread_id=? ORDER BY rowid DESC LIMIT 50 OFFSET ?", (thread_id, offset))
        rows = c.fetchall()
        conn.close()
        history = [json.loads(row[0]) for row in reversed(rows)]
        return {"status": "success", "data": history}
    except Exception as e:
        return {"status": "error", "data": []}

# --- API MỚI: KIỂM TRA NHỊP TIM CỦA BOT ---
@app.get("/api/bot_status")
async def check_bot_status():
    """Gọi sang cổng 3667 để xem file main.py có đang chạy không"""
    try:
        res = requests.get("http://127.0.0.1:3667/ping", timeout=1)
        if res.status_code == 200:
            return {"status": "online"}
    except:
        pass
    return {"status": "offline"}

