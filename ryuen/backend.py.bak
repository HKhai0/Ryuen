                <input type="text" id="main-chat-input" class="chat-main-input" placeholder="Nhập tin nhắn để gửi vào nhóm này..." onkeypress="if(event.key === 'Enter') sendMainMessage()">
                <button class="btn react-btn" onclick="sendMainMessage()" style="padding: 0 25px;">Gửi</button>
            </div>
        </div>

    </div> 
    <script>
        const threadsData = {}; 
        let currentActiveThread = null;
        let isFetchingHistory = false; 

        // KHAI BÁO CÁC BIẾN GIAO DIỆN
        const threadListEl = document.getElementById("thread-list");
        const chatContainer = document.getElementById("chat-container");
        const chatTitleEl = document.getElementById("current-chat-title");
        const wsDot = document.getElementById("ws-dot");
        const botDot = document.getElementById("bot-dot");

        // GẮN SỰ KIỆN CUỘN CHUỘT (INFINITE SCROLL)
        chatContainer.addEventListener("scroll", async () => {
            if (chatContainer.scrollTop === 0 && currentActiveThread && !isFetchingHistory) {
                await loadMoreMessages(currentActiveThread);
            }
        });

        async function loadMoreMessages(thread_id) {
            isFetchingHistory = true;
            const currentOffset = threadsData[thread_id].messages.length;
            
            const loadingDiv = document.createElement("div");
            loadingDiv.id = "loading-history";
            loadingDiv.style.textAlign = "center";
            loadingDiv.style.color = "var(--text-sub)";
            loadingDiv.style.padding = "10px";
            loadingDiv.style.fontSize = "0.85em";
            loadingDiv.innerText = "⏳ Đang tải thêm tin nhắn cũ...";
            chatContainer.prepend(loadingDiv);

            const oldScrollHeight = chatContainer.scrollHeight;

            try {
                const res = await fetch(`/api/thread_history?thread_id=${thread_id}&offset=${currentOffset}`);
                const result = await res.json();
                
                if (result.status === 'success' && result.data.length > 0) {
                    threadsData[thread_id].messages = [...result.data, ...threadsData[thread_id].messages];
                    chatContainer.innerHTML = "";
                    threadsData[thread_id].messages.forEach(msg => renderSingleMessage(msg));
                    const newScrollHeight = chatContainer.scrollHeight;
                    chatContainer.scrollTop = newScrollHeight - oldScrollHeight;
                } else {
                    loadingDiv.innerText = "Đã xem hết lịch sử tin nhắn.";
                    setTimeout(() => loadingDiv.remove(), 2000);
                }
            } catch (e) {
                console.error("Lỗi tải thêm:", e);
            } finally {
                if (document.getElementById("loading-history")) document.getElementById("loading-history").remove();
                isFetchingHistory = false;
            }
        }

        // XỬ LÝ WEBSOCKET VÀ PING TRẠNG THÁI
        const ws = new WebSocket(`ws://${location.host}/ws`);
        ws.onopen = () => wsDot.classList.add("online");
        ws.onclose = () => wsDot.classList.remove("online");

        setInterval(async () => {
            try {
                const res = await fetch('/api/bot_status');
                const result = await res.json();
                if(result.status === 'online') botDot.classList.add("online");
                else botDot.classList.remove("online");
            } catch(e) { botDot.classList.remove("online"); }
        }, 3000);

        // TẢI LỊCH SỬ KHI MỞ TRANG LẦN ĐẦU
        window.onload = async () => {
            try {
                const res = await fetch('/api/history');
                const result = await res.json();
                if (result.status === 'success' && result.data.length > 0) {
                    threadListEl.innerHTML = "";
                    result.data.forEach(msg => processMessage(msg, true));
                } else {
                    threadListEl.innerHTML = `<div style="text-align:center; color: var(--text-sub); margin-top: 20px; font-size: 0.9em;">Chưa có tin nhắn nào</div>`;
                }
            } catch (error) { console.error("Lỗi tải lịch sử:", error); }
        };

        ws.onmessage = (event) => {
            const data = JSON.parse(event.data);
            processMessage(data, false);
        };

        // --- CẢI TIẾN LOGIC HIỂN THỊ TÊN ĐỂ CHỐNG LỖI "Zlapi Runner" ---
        function processMessage(data, isHistory = false) {
            if(data.event_type !== "onMessage") return; 
            
            const msgData = data.data;
            const thread_id = msgData.thread_id;
            
            let thread_name = "Chưa rõ Tên";
            
            // Nếu có group_name và nó hợp lệ -> Đây là chat Nhóm
            if (msgData.group_name && msgData.group_name !== "None" && msgData.group_name !== "") {
                thread_name = msgData.group_name;
            } 
            // Nếu không có group_name -> Đây là chat Cá Nhân 1-1
            else {
                thread_name = (msgData.author_name && msgData.author_name !== "None") ? msgData.author_name : `User: ${thread_id}`;
                // Tránh việc lấy tên Zlapi Runner làm tên nhóm khi bot tự reply
                if (data.is_bot) {
                     thread_name = `Chat 1-1 (ID: ${thread_id})`; 
                }
            }

            if (!threadsData[thread_id]) {
                threadsData[thread_id] = { name: thread_name, messages: [] };
                renderThreadItem(thread_id, thread_name);
            }

            threadsData[thread_id].messages.push(data);
            updateThreadPreview(thread_id, msgData.msg_text);

            if (currentActiveThread === thread_id) {
                renderSingleMessage(data);
                if (!isHistory) scrollToBottom();
            } else if (!isHistory) {
                const threadItem = document.getElementById(`thread-${thread_id}`);
                if (threadItem) threadItem.classList.add("unread");
            }
        }

        function renderThreadItem(thread_id, name) {
            if(document.querySelector("#thread-list > div[style]")) threadListEl.innerHTML = "";
            const div = document.createElement("div");
            div.className = "thread-item";
            div.id = `thread-${thread_id}`;
            div.onclick = () => selectThread(thread_id);
            div.innerHTML = `
                <div class="thread-name">🏠 ${name}</div>
                <div class="thread-preview" id="preview-${thread_id}">...</div>
                <div class="unread-dot"></div>
            `;
            threadListEl.prepend(div);
        }

        function updateThreadPreview(thread_id, text) {
            const previewEl = document.getElementById(`preview-${thread_id}`);
            if (previewEl) previewEl.innerText = text;
            const item = document.getElementById(`thread-${thread_id}`);
            if (item) threadListEl.prepend(item);
        }

        function selectThread(thread_id) {
            currentActiveThread = thread_id;
            document.querySelectorAll('.thread-item').forEach(el => el.classList.remove('active'));
            const activeItem = document.getElementById(`thread-${thread_id}`);
            if (activeItem) {
                activeItem.classList.add('active');
                activeItem.classList.remove('unread');
            }

            chatTitleEl.innerHTML = `🏠 ${threadsData[thread_id].name} <span style="font-size:0.6em; color:var(--text-sub)">(${thread_id})</span>`;
            chatContainer.innerHTML = "";
            threadsData[thread_id].messages.forEach(msg => renderSingleMessage(msg));
            scrollToBottom();
        }

        // --- HÀM MEDIA PARSER ---
        function parseMediaLink(url) {
            if (!url || !url.startsWith("http")) return "";
            const cleanUrl = url.split('?')[0].toLowerCase();
            
            if (cleanUrl.match(/\.(jpeg|jpg|gif|png|webp|jxl)$/)) {
                return `<div class="media-container"><img src="${url}" class="img-preview" onclick="window.open('${url}', '_blank')" title="Click để xem full"></div>`;
            }
            if (cleanUrl.match(/\.(mp4|webm|ogg|mov)$/)) {
                return `
                <div class="media-container">
                    <video controls class="video-preview" preload="metadata">
                        <source src="${url}" type="video/mp4">
                        Trình duyệt của bạn không hỗ trợ video HTML5.
                    </video>
                </div>`;
            }
            return `
            <div class="media-container">
                <a href="${url}" target="_blank" class="link-card">
                    <span class="link-icon">🔗</span>
                    <span class="link-text">Mở Liên Kết Ngoài</span>
                </a>
            </div>`;
        }

        function renderSingleMessage(data) {
            const msgData = data.data;
            const isBot = data.is_bot;
            const authorName = msgData.author_name || msgData.author_id;
            const content = msgData.msg_text;
            const time = msgData.timestamp;
            const mid = msgData.mid;
            const thread_id = msgData.thread_id;

            const authorClass = isBot ? "author is-bot" : "author";
            const botBadge = isBot ? `<span class="bot-badge">BOT</span>` : "";

            let mediaHtml = "";
            let extractedUrl = null;
            const obj = msgData.object;
            
            if (obj && obj !== "None" && obj !== "") {
                if (typeof obj === 'object') {
                    extractedUrl = obj.href || obj.thumb;
                    if(obj.params) {
                        try {
                            const params = typeof obj.params === 'string' ? JSON.parse(obj.params) : obj.params;
                            extractedUrl = params.hd || params.href || extractedUrl;
                        } catch(e) {}
                    }
                } else if (typeof obj === 'string') {
                    const hrefMatch = obj.match(/href='([^']+)'/);
                    const hdMatch = obj.match(/"hd":"([^"]+)"/);
                    if (hdMatch) extractedUrl = hdMatch[1].replace(/\\\\/g, "");
                    else if (hrefMatch) extractedUrl = hrefMatch[1];
                }
            }
            
            if (!extractedUrl && content) {
                const urlRegex = /(https?:\/\/[^\s]+)/;
                const match = content.match(urlRegex);
                if (match) {
                    extractedUrl = match[0];
                }
            }

            if (extractedUrl) {
                mediaHtml = parseMediaLink(extractedUrl);
            }

            const row = document.createElement("div");
            row.className = "message-row";
            row.innerHTML = `
                <div class="msg-header">
                    <span class="${authorClass}">${authorName}</span> ${botBadge} <span class="time">${time}</span>
                </div>
                <div class="content">${content}</div>
                ${mediaHtml}
                <div class="msg-tools">
                    <input type="text" id="react-${mid}" class="react-input" maxlength="20" placeholder="Icon / text..." onkeypress="if(event.key === 'Enter') sendReact('${mid}', '${thread_id}')">
                    <button class="btn react-btn" onclick="sendReact('${mid}', '${thread_id}')">React</button>
                    
                    <input type="text" id="reply-${mid}" class="react-input" placeholder="Nhập để Reply..." onkeypress="if(event.key === 'Enter') sendReply('${mid}', '${thread_id}')">
                    <button class="btn" onclick="sendReply('${mid}', '${thread_id}')">Reply</button>
                    
                    <button class="btn" onclick="this.parentElement.nextElementSibling.classList.toggle('show')">{JSON}</button>
                </div>
                <div class="payload-box">${JSON.stringify(data, null, 4)}</div>
            `;
            chatContainer.appendChild(row);
        }

        function scrollToBottom() { chatContainer.scrollTop = chatContainer.scrollHeight; }

        async function sendReact(mid, thread_id) {
            const inputEl = document.getElementById(`react-${mid}`);
            const iconText = inputEl.value.trim();
            if(!iconText) return;
            try {
                const response = await fetch('/api/react', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mid: mid, thread_id: thread_id, icon: iconText })
                });
                const result = await response.json();
                if(result.status === "success") {
                    inputEl.style.borderColor = "#23a559"; 
                    setTimeout(() => inputEl.style.borderColor = "var(--divider)", 1500);
                    inputEl.value = ""; 
                }
            } catch (error) { alert("Lỗi kết nối Backend!"); }
        }

        async function sendReply(mid, thread_id) {
            const inputEl = document.getElementById(`reply-${mid}`);
            const text = inputEl.value.trim();
            if(!text) return;
            try {
                const res = await fetch('/api/reply', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mid: mid, thread_id: thread_id, text: text })
                });
                if((await res.json()).status === "success") {
                    inputEl.style.borderColor = "#23a559"; 
                    setTimeout(() => inputEl.style.borderColor = "var(--divider)", 1500);
                    inputEl.value = ""; 
                    renderSelfMessage(text, thread_id);
                }
            } catch (error) { alert("Lỗi kết nối Backend!"); }
        }

        async function sendMainMessage() {
            if(!currentActiveThread) return alert("Vui lòng chọn 1 nhóm bên trái trước khi gửi!");
            
            const inputEl = document.getElementById('main-chat-input');
            const text = inputEl.value.trim();
            if(!text) return;

            const firstMsg = threadsData[currentActiveThread].messages[0];
            const t_type = firstMsg ? firstMsg.data.thread_type : "1";

            try {
                const res = await fetch('/api/send', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ thread_id: currentActiveThread, thread_type: t_type, text: text })
                });
                if((await res.json()).status === "success") { 
                    inputEl.value = ""; 
                    renderSelfMessage(text, currentActiveThread);
                }
            } catch (error) { alert("Lỗi kết nối Backend!"); }
        }
        
        function renderSelfMessage(text, thread_id) {
            if(currentActiveThread !== thread_id) return;
            
            const now = new Date();
            const timeStr = now.getHours().toString().padStart(2, '0') + ":" + now.getMinutes().toString().padStart(2, '0') + ":" + now.getSeconds().toString().padStart(2, '0');
            
            const row = document.createElement("div");
            row.className = "message-row";
            row.style.backgroundColor = "rgba(88, 101, 242, 0.1)"; 
            
            let mediaHtml = "";
            const urlRegex = /(https?:\/\/[^\s]+)/;
            const match = text.match(urlRegex);
            if (match) { mediaHtml = parseMediaLink(match[0]); }
            
            row.innerHTML = `
                <div class="msg-header">
                    <span class="author is-bot">Zlapi Web UI</span> 
                    <span class="bot-badge">ADMIN</span> 
                    <span class="time">${timeStr}</span>
                </div>
                <div class="content">${text}</div>
                ${mediaHtml}
            `;
            
            chatContainer.appendChild(row);
            scrollToBottom();
        }
    </script>
</body>
</html>
"""

@app.get("/")
async def dashboard(): return HTMLResponse(HTML_PAGE)

@app.websocket("/ws")
async def websocket_endpoint(websocket: WebSocket):
    await manager.connect(websocket)
    try:
        while True: await websocket.receive_text()
    except WebSocketDisconnect:
        manager.disconnect(websocket)
host = "0.0.0.0"
port = 6736
if __name__ == "__main__":
    print(f"{Fore.CYAN}🧠 Backend ZLAPI Server chạy tại: http://127.0.0.1:6736")
    uvicorn.run(app, host=host, port=port)
